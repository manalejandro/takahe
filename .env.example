# Archivo de configuración de ejemplo para Takahe
# Copia este archivo a .env y configura según tu entorno

# ============================================================================
# CONFIGURACIÓN CRÍTICA DE SEGURIDAD
# ============================================================================

# SECRET_KEY: Llave secreta para firmar sesiones (OBLIGATORIO en producción)
# Genera una con: python -c "import secrets; print(secrets.token_hex(128))"
TAKAHE_SECRET_KEY=

# MAIN_DOMAIN: Dominio principal de tu instancia (OBLIGATORIO)
TAKAHE_MAIN_DOMAIN=example.com

# ALLOWED_HOSTS: Lista de hosts permitidos (OBLIGATORIO en producción)
# Formato: ["domain.com","www.domain.com"] o separados por comas
TAKAHE_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# DEBUG: Solo activar en desarrollo (NUNCA en producción)
TAKAHE_DEBUG=False

# ============================================================================
# BASE DE DATOS
# ============================================================================

# Opción 1: URL completa de base de datos
# DATABASE_SERVER: postgresql://user:password@host:port/database
# DATABASE_SERVER: sqlite:///takahe.db

# Opción 2: Variables individuales de PostgreSQL (sin prefijo TAKAHE_)
PGHOST=localhost
PGPORT=5432
PGNAME=takahe
PGUSER=postgres
PGPASSWORD=

# ============================================================================
# SEGURIDAD Y PROXY
# ============================================================================

# USE_PROXY_HEADERS: Activar si estás detrás de un proxy/load balancer
TAKAHE_USE_PROXY_HEADERS=False

# STATOR_TOKEN: Token para proteger el worker Stator
# Genera uno con: python -c "import secrets; print(secrets.token_hex(128))"
TAKAHE_STATOR_TOKEN=

# ============================================================================
# CORS Y CSRF
# ============================================================================

# CORS_HOSTS: Hosts permitidos para CORS (formato JSON array)
TAKAHE_CORS_HOSTS=[]

# CSRF_HOSTS: Hosts de confianza para CSRF (formato JSON array)
# Ejemplo: ["https://yourdomain.com"]
TAKAHE_CSRF_HOSTS=[]

# ============================================================================
# EMAIL
# ============================================================================

# EMAIL_SERVER: Configuración del servidor de email
# Ejemplos:
#   - console://localhost (para desarrollo, imprime en consola)
#   - smtp://user:password@smtp.gmail.com:587?tls=true
#   - sendgrid://apikey
TAKAHE_EMAIL_SERVER=console://localhost
TAKAHE_EMAIL_FROM=noreply@example.com

# AUTO_ADMIN_EMAIL: Email del primer administrador (opcional)
TAKAHE_AUTO_ADMIN_EMAIL=

# ERROR_EMAILS: Emails para notificaciones de errores (formato JSON array)
TAKAHE_ERROR_EMAILS=[]

# ============================================================================
# ALMACENAMIENTO DE MEDIA
# ============================================================================

# MEDIA_BACKEND: Backend de almacenamiento para archivos media
# Opciones:
#   - local:// (almacenamiento local, requiere MEDIA_ROOT y MEDIA_URL)
#   - s3://access_key:secret_key@/bucket_name
#   - s3-insecure:// (para S3 compatible sin HTTPS)
#   - gs:///bucket_name (Google Cloud Storage)
TAKAHE_MEDIA_BACKEND=local://
TAKAHE_MEDIA_ROOT=/path/to/media
TAKAHE_MEDIA_URL=https://yourdomain.com/media/

# MEDIA_BACKEND_S3_ACL: ACL para objetos S3 (public-read o private)
TAKAHE_MEDIA_BACKEND_S3_ACL=public-read

# Límites de tamaño de archivos (en MB o KB)
TAKAHE_MEDIA_MAX_IMAGE_FILESIZE_MB=10
TAKAHE_AVATAR_MAX_IMAGE_FILESIZE_KB=1000
TAKAHE_EMOJI_MAX_IMAGE_FILESIZE_KB=200

# ============================================================================
# CACHE
# ============================================================================

# CACHES_DEFAULT: Backend de caché
# Ejemplos:
#   - dummy:// (sin caché, para desarrollo)
#   - redis://localhost:6379/0
#   - memcached://localhost:11211
TAKAHE_CACHES_DEFAULT=dummy://

# ============================================================================
# SENTRY (Monitoreo de Errores)
# ============================================================================

# SENTRY_DSN: DSN de Sentry para tracking de errores
TAKAHE_SENTRY_DSN=

# SENTRY_SAMPLE_RATE: Tasa de muestreo de errores (0.0 a 1.0)
TAKAHE_SENTRY_SAMPLE_RATE=1.0

# SENTRY_TRACES_SAMPLE_RATE: Tasa de muestreo de trazas de rendimiento
TAKAHE_SENTRY_TRACES_SAMPLE_RATE=0.01

# SENTRY_CAPTURE_MESSAGES: Capturar mensajes de log
TAKAHE_SENTRY_CAPTURE_MESSAGES=False

# ============================================================================
# CONFIGURACIÓN AVANZADA
# ============================================================================

# ENVIRONMENT: Entorno de ejecución (development, production, test)
TAKAHE_ENVIRONMENT=development

# DEBUG_TOOLBAR: Activar Django Debug Toolbar (solo con DEBUG=True)
TAKAHE_DEBUG_TOOLBAR=False

# REMOTE_TIMEOUT: Timeout para peticiones a servidores remotos (segundos)
TAKAHE_REMOTE_TIMEOUT=5.0

# REMOTE_PRUNE_HORIZON: Días antes de limpiar contenido remoto no usado
TAKAHE_REMOTE_PRUNE_HORIZON=90

# STATOR_CONCURRENCY: Número de workers concurrentes de Stator
TAKAHE_STATOR_CONCURRENCY=20
TAKAHE_STATOR_CONCURRENCY_PER_MODEL=4

# ALLOW_USER_MIGRATION: Permitir migración de usuarios
TAKAHE_ALLOW_USER_MIGRATION=False

# SEARCH: Habilitar funciones de búsqueda
TAKAHE_SEARCH=True

# ============================================================================
# WEB PUSH NOTIFICATIONS
# ============================================================================

# Genera keys en: https://web-push-codelab.glitch.me/
TAKAHE_VAPID_PUBLIC_KEY=
TAKAHE_VAPID_PRIVATE_KEY=

# ============================================================================
# ROBOTS.TXT
# ============================================================================

# User agents a bloquear en robots.txt (formato JSON array)
# Ejemplo: ["BadBot","AnotherBot"]
TAKAHE_ROBOTS_TXT_DISALLOWED_USER_AGENTS=[]

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# 1. En producción, DEBES configurar:
#    - TAKAHE_SECRET_KEY (única y aleatoria)
#    - TAKAHE_MAIN_DOMAIN
#    - TAKAHE_ALLOWED_HOSTS
#    - Configuración de base de datos
#
# 2. Nunca compartas tu .env en repositorios públicos
#
# 3. Para más información, consulta:
#    - SECURITY.md
#    - docs/installation.rst
#
# 4. Ejecuta security_check.py para verificar tu configuración
#
# ============================================================================
